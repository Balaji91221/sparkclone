# --- LLM provider ---
LLM_PROVIDER=nvidia
NVIDIA_API_KEY=nvapi-...
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_ENABLE_THINKING=true
NVIDIA_REASONING_BUDGET=16384
LLM_MAX_RPS=2

# Optional fallback provider
# LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
SPARK_API_TOKEN=generate-a-long-random-token
WORKERS=4
TZ=Asia/Kolkata

# Email (optional). For Gmail use an App Password.
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASSWORD=app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=app-password
NOTIFY_EMAIL=you@gmail.com

# --- Google OAuth (Gmail + Drive connect) ---
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
OAUTH_REDIRECT_URL=http://localhost:3000/auth/google/callback
# Signs OAuth state + encrypts stored refresh tokens (openssl rand -hex 24)
SPARK_SECRET_KEY=generate-a-long-random-secret
